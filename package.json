  "scripts": {
    "build": "yarn build:offline",
    "build:offline": "node --max_old_space_size=2048 --stack-size=100000 node_modules/gulp/bin/gulp.js build --offline",
    "build:installer": "yarn build:offline --env staging && npm --prefix desktop-offline ci && npm --prefix desktop-offline run dist:windows",
    "start:offline": "node scripts/serve_offline.js",
    "offline": "yarn build:offline && yarn start:offline",
    "build:app": "node --max_old_space_size=2048 --stack-size=100000 node_modules/gulp/bin/gulp.js build:app --offline",
    "build:web": "node --max_old_space_size=2048 --stack-size=100000 node_modules/gulp/bin/gulp.js build:web --offline",
    "lint:coffee": "coffeelint -f coffeelint.json -q app",
    "lint:coffee:all": "coffeelint -f coffeelint.json -q app scripts",
    "lint:js": "eslint --quiet",
    "lint:js:all": "eslint --quiet .babelrc .mocharc.js app bulk-decaffeinate.config.js config desktop-offline gulp gulpfile.babel.js scripts test",
    "format:js": "eslint --quiet --fix",
    "format:js:all": "eslint --quiet --fix .babelrc .mocharc.js app bulk-decaffeinate.config.js config desktop-offline gulp gulpfile.babel.js scripts test",
    "minify": "yarn build:offline --env staging",
    "packages": "node node_modules/gulp/bin/gulp.js rsx --offline",
    "rsx:copy": "node node_modules/gulp/bin/gulp.js rsx:copy --offline",
    "rsx:copy:web": "node node_modules/gulp/bin/gulp.js rsx:copy:web --offline",
    "test": "yarn test:unit",
    "test:offline": "mocha -t 10000 --recursive test/unit/offline test/unit/localization test/unit/session/offline.js test/unit/sdk/ai test/unit/sdk/challenges/offline_practice.js",
    "test:unit": "mocha -t 10000 --recursive test/unit",
    "test:unit:sdk": "mocha -t 10000 --recursive test/unit/sdk",
    "test:unit:session": "mocha -t 10000 test/unit/session/offline.js",
    "watch": "node --max_old_space_size=2048 --stack-size=100000 node_modules/gulp/bin/gulp.js build --offline --watch"
  },
  "packageManager": "yarn@4.9.2"
}
